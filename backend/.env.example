# CodeTrack Classroom Backend Configuration

# Server Port
PORT=5000

# Secret Key
SECRET_KEY=codetrack-super-secret-key-2026

# Database Connection (SQLite default, or MongoDB Atlas / PostgreSQL)
# For SQLite (Local):
DATABASE_URL=sqlite:///codetrack.db

# For MongoDB Atlas Connection (Optional):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codetrack?retryWrites=true&w=majority

# CORS Allowed Origins
CORS_ORIGIN=*
